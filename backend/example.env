# Server Settings
BACKEND_INTERNAL_PORT=8080
BACKEND_EXTERNAL_PORT=8080
SERVER_SSL_KEY_STORE=classpath:keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=vash_parol
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_KEY_ALIAS=spring-boot-alias
SERVER_SSL_ENABLED=false