server {
    listen 80;
    server_name ${SERVER_NAME}; # Замените на ваш домен

    # Редирект с HTTP на HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};

    # Пути к сертификатам ВНУТРИ контейнера (мы их пробросим через volumes)
    ssl_certificate /etc/nginx/certs/certificate.crt;
    ssl_certificate_key /etc/nginx/certs/certificate.key;

    # Рекомендованные настройки SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # --- ФРОНТЕНД ---
    location / {
        # 'frontend' — это имя сервиса из docker-compose
        proxy_pass http://frontend:80; 
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- БЭКЕНД ---
    # Если фронт стучится на /api, пересылаем на Spring Boot
    location /api {
        # 'backend' — имя сервиса Spring Boot
        proxy_pass http://backend:8080/api; 
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
